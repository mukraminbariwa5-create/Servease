# Fixoria — Apache configuration (works with XAMPP's default mod_rewrite)
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never serve application internals, private storage or archived code directly
    RewriteRule ^(app|config|database|storage|tests|_old|fixoria-prototype)(/|$) - [F,L]
    RewriteRule (^|/)\. - [F,L]
    RewriteRule \.(sql|md|log|env|ini)$ - [F,L,NC]

    # Serve real files (css, js, images, uploads) as-is
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Everything else goes through the front controller
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Long-lived caching for static assets (URLs are versioned with ?v=)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
